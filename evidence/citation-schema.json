{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Copilot answer",
  "type": "object",
  "properties": {
    "snapshot_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "answered",
        "partial",
        "insufficient_evidence"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "referenced_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "file_path": {
            "type": "string",
            "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        },
        "required": [
          "qualified_name",
          "file_path"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "file_path": {
            "type": "string",
            "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "code_snippet": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file_path",
          "start_line",
          "end_line",
          "code_snippet"
        ],
        "additionalProperties": false
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "snapshot_commit",
    "status",
    "answer",
    "referenced_symbols",
    "citations",
    "confidence_score",
    "limitations",
    "missing_context"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "insufficient_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "const": "No matching implementation found in codebase. This feature is not present."
          },
          "confidence_score": {
            "const": 0
          },
          "referenced_symbols": {
            "maxItems": 0
          },
          "citations": {
            "maxItems": 0
          },
          "missing_context": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "citations": {
            "minItems": 1
          },
          "confidence_score": {
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "missing_context": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
